+name: iOS 16 source compile check
+"on":
+  workflow_dispatch:
+    inputs:
+      runner:
+        description: macOS runner with Xcode 26 or newer (override for a custom runner)
+        type: string
+        default: macos-26
+        required: true
+permissions:
+  contents: read
+jobs:
+  native:
+    runs-on: ${{ inputs.runner }}
+    timeout-minutes: 30
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          persist-credentials: false
+          submodules: false
+      - name: Ensure Metal compiler is available
+        run: |
+          mkdir -p .build/ios16-native-diagnostics
+          if ! xcrun --sdk iphoneos metal --version > .build/ios16-native-diagnostics/metal-toolchain.log 2>&1; then
+            xcodebuild -downloadComponent MetalToolchain 2>&1 | tee -a .build/ios16-native-diagnostics/metal-toolchain.log
+          fi
+      - name: Check native iOS 16 APIs and Metal 3.0 helper shaders
+        run: bash ci/check-ios16-native.sh
+      - name: Retain native diagnostics
+        if: always()
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
+        with:
+          name: Iridium-iOS16-native-diagnostics
+          path: |
+            .build/ios16-native-diagnostics/*.log
+            .build/ios16-native-diagnostics/*.tsv
+          if-no-files-found: warn
+          retention-days: 7
+  compile:
+    runs-on: ${{ inputs.runner }}
+    timeout-minutes: 45
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          persist-credentials: false
+          submodules: false
+      - name: Check source
+        run: |
+          python3 check-public-source.py
+          python3 ci/check-standards.py
+      - name: Install project generator
+        run: brew install xcodegen
+      - name: Compile iOS 16 Swift and adapter sources (no runtime link)
+        run: bash ci/check-ios16-compile.sh
+      - name: Retain compiler diagnostics
+        if: always()
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
+        with:
+          name: Iridium-iOS16-compiler-diagnostics
+          path: |
+            .build/ios16-diagnostics/*.log
+            .build/ios16-diagnostics/*.xcresult
+          if-no-files-found: warn
+          retention-days: 7
