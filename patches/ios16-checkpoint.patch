+#!/bin/bash
+# Compile real native translation units at the proposed minimum, without linking
+# or substituting runtime functions. Attempt every unit to retain all diagnostics.
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+cd "$ROOT"
+OUT="$ROOT/.build/ios16-native-diagnostics"
+mkdir -p "$OUT/objects" "$OUT/metal"
+test "$(uname -s)" = Darwin || { echo 'Requires macOS and an iPhoneOS SDK.' >&2; exit 1; }
+SDK="$(xcrun --sdk iphoneos --show-sdk-path)"
+APP="$ROOT/testrepos/Madeira/app/Madeira"
+DXMT="$ROOT/testrepos/Madeira/research/dxmt"
+SUPPORT="$ROOT/iridium/apps/ios/MadeiraSupport"
+common=(-target arm64-apple-ios16.0 -isysroot "$SDK" -O2 -fblocks
+        -Werror=unguarded-availability -Werror=unguarded-availability-new)
+failures=0
+printf 'unit\tresult\n' > "$OUT/summary.tsv"
+{
+  xcodebuild -version
+  xcrun --sdk iphoneos --show-sdk-version
+  echo 'Requested device minimum: iOS 16.0; native availability warnings are errors.'
+  echo 'This does not compile all FEX/Wine/LLVM/media dependencies or link an app.'
+} > "$OUT/toolchain.log"
+
+compile() {
+  local name="$1" source="$2" language="$3"
+  shift 3
+  # Never retain a stale object after a failed incremental probe.
+  rm -f "$OUT/objects/$name.o"
+  echo "Checking $name"
+  if xcrun --sdk iphoneos clang "${common[@]}" -x "$language" "$@" \
+       -c "$source" -o "$OUT/objects/$name.o" > "$OUT/$name.log" 2>&1; then
+    printf '%s\tPASS\n' "$name" >> "$OUT/summary.tsv"
+    xcrun otool -l "$OUT/objects/$name.o" > "$OUT/$name.load-commands.log"
+    xcrun nm -u "$OUT/objects/$name.o" > "$OUT/$name.imports.log"
+  else
+    printf '%s\tFAIL\n' "$name" >> "$OUT/summary.tsv"
+    failures=$((failures + 1))
+  fi
+}
+
+# Match the production MadeiraNative ARC and forced-environment-header settings.
+appflags=(-I "$APP" -I "$SUPPORT" -DWINE_IOS=1 -include "$SUPPORT/MadeiraSteamEnv.h")
+for name in JITAllocator PrefixExtractor; do
+  compile "$name" "$APP/$name.c" c "${appflags[@]}"
+done
+for name in IOSDisplayShim WineServerBridge WineProcessBridge; do
+  compile "$name" "$APP/$name.m" objective-c -fobjc-arc "${appflags[@]}"
+done
+compile Winios "$APP/Winios/Winios.m" objective-c -fobjc-arc "${appflags[@]}"
+compile WiniosGamepad "$APP/Winios/WiniosGamepad.c" c "${appflags[@]}"
+for name in NativePool MadeiraGuestControl MadeiraSteamEnv; do
+  compile "$name" "$SUPPORT/$name.c" c "${appflags[@]}"
+done
+
+# The upstream DXMT Unix bridge uses manual reference counting, not ARC.
+dxmtflags=(-I "$DXMT/include" -I "$DXMT/libs" -I "$DXMT/src/winemetal" -I "$DXMT/src/airconv")
+compile winemetal_unix "$DXMT/src/winemetal/unix/winemetal_unix.c" objective-c "${dxmtflags[@]}"
+compile winemetal_cache "$DXMT/src/winemetal/unix/cache.c" objective-c "${dxmtflags[@]}"
+
+# Test original helper source against Metal 3.0. Do not relabel existing AIR,
+# change production shaders, or mistake helper success for a DXBC backend port.
+for name in air_msad air_samplepos air_tessellation; do
+  rm -f "$OUT/metal/$name.air"
+  echo "Checking Metal 3.0: $name"
+  if xcrun --sdk iphoneos metal -std=metal3.0 --target=air64-apple-ios16.0 \
+       -c "$DXMT/src/airconv/shaders/$name.metal" -o "$OUT/metal/$name.air" \
+       > "$OUT/$name.log" 2>&1; then
+    printf '%s\tPASS\n' "$name" >> "$OUT/summary.tsv"
+  else
+    printf '%s\tFAIL\n' "$name" >> "$OUT/summary.tsv"
+    failures=$((failures + 1))
+  fi
+done
+cat "$OUT/summary.tsv"
+echo "$failures native/shader checks failed. No executable or IPA was produced."
+test "$failures" -eq 0
