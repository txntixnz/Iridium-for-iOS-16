+#!/bin/bash
+# Availability/type-check checkpoint only. Does not build an installable app.
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+cd "$ROOT"
+mkdir -p .build/ios16-diagnostics
+test "$(uname -s)" = Darwin || { echo 'This check requires macOS with Xcode.' >&2; exit 1; }
+xcodebuild -version | tee .build/ios16-diagnostics/toolchain.log
+xcrun --sdk iphoneos --show-sdk-version | tee -a .build/ios16-diagnostics/toolchain.log
+python3 - "$(xcrun --sdk iphoneos --show-sdk-version)" <<'PY'
+import sys
+if int(sys.argv[1].split('.')[0]) < 26:
+    raise SystemExit('Select Xcode with iOS SDK 26 or newer; the upstream guarded glass UI needs it.')
+PY
+xcodegen generate --spec iridium/apps/ios/ios16-compile.yml
+result=".build/ios16-diagnostics/compile-$(date +%Y%m%d-%H%M%S).xcresult"
+xcodebuild -project iridium/apps/ios/IridiumIOS16Compile.xcodeproj \
+  -scheme IridiumIOS16Compile -configuration Debug \
+  -destination 'generic/platform=iOS' -derivedDataPath .build/ios16-compile \
+  -resultBundlePath "$result" IPHONEOS_DEPLOYMENT_TARGET=16.0 \
+  CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO \
+  CODE_SIGN_IDENTITY= DEVELOPMENT_TEAM= build \
+  2>&1 | tee .build/ios16-diagnostics/compile.log
+echo 'Source compilation passed. Runtime linking, IPA installation, JIT and rendering are NOT tested.'
