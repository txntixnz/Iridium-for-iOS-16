+"""Test probe orchestration with a fake toolchain, never native compatibility."""
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+
+
+class NativeProbeTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        (self.root / 'ci').mkdir()
+        shutil.copyfile(Path(__file__).with_name('check-ios16-native.sh'),
+                        self.root / 'ci/check-ios16-native.sh')
+        self.bin = self.root / 'bin'
+        self.bin.mkdir()
+        for name, body in {
+            'uname': '#!/bin/sh\necho Darwin\n',
+            'xcodebuild': '#!/bin/sh\necho Fake-toolchain-for-unit-tests\n',
+            'xcrun': f'#!{sys.executable}\n' + '''import os, pathlib, sys
+args = sys.argv[1:]
+if '--show-sdk-path' in args:
+    print('/fake-sdk')
+elif '--show-sdk-version' in args:
+    print('26.0')
+elif '-c' in args:
+    output = pathlib.Path(args[args.index('-o') + 1])
+    expected = 'air64-apple-ios16.0' if 'metal' in args else 'arm64-apple-ios16.0'
+    if not any(expected in arg for arg in args):
+        sys.exit(3)
+    if 'clang' in args and '-Werror=unguarded-availability-new' not in args:
+        sys.exit(4)
+    if 'metal' in args and '-std=metal3.0' not in args:
+        sys.exit(5)
+    if output.stem == os.environ.get('PROBE_FAIL_UNIT'):
+        sys.exit(2)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text('FAKE UNIT TEST OBJECT - NOT MACHINE CODE')
+else:
+    print('Fake inspection output')
+''',
+        }.items():
+            path = self.bin / name
+            path.write_text(body)
+            path.chmod(0o755)
+        self.out = self.root / '.build/ios16-native-diagnostics'
+
+    def run_probe(self, fail=''):
+        return subprocess.run(
+            ['bash', str(self.root / 'ci/check-ios16-native.sh')],
+            env={**os.environ, 'PATH': str(self.bin) + os.pathsep + os.environ['PATH'],
+                 'PROBE_FAIL_UNIT': fail},
+            capture_output=True, text=True,
+        )
+
+    def test_compiles_all_units_with_requested_target(self):
+        result = self.run_probe()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        rows = (self.out / 'summary.tsv').read_text().splitlines()[1:]
+        self.assertEqual(len(rows), 15)
+        self.assertTrue(all(row.endswith('\tPASS') for row in rows))
+
+    def test_failure_keeps_later_diagnostics_and_returns_failure(self):
+        result = self.run_probe('JITAllocator')
+        self.assertNotEqual(result.returncode, 0)
+        summary = (self.out / 'summary.tsv').read_text()
+        self.assertIn('JITAllocator\tFAIL', summary)
+        self.assertIn('air_tessellation\tPASS', summary)
+        self.assertTrue((self.out / 'JITAllocator.log').is_file())
+
+    def test_failed_rebuild_does_not_reuse_old_object(self):
+        self.assertEqual(self.run_probe().returncode, 0)
+        self.assertTrue((self.out / 'objects/JITAllocator.o').is_file())
+        self.assertNotEqual(self.run_probe('JITAllocator').returncode, 0)
+        self.assertFalse((self.out / 'objects/JITAllocator.o').exists())
+
+
+if __name__ == '__main__':
+    unittest.main()
