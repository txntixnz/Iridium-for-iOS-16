+# Compile-only diagnostic. No executable, IPA, runtime implementation, or signing.
+name: IridiumIOS16Compile
+packages:
+  IridiumPackage:
+    path: ../..
+  AltKit:
+    url: https://github.com/rileytestut/AltKit.git
+    from: 0.0.2
+settings:
+  base:
+    IPHONEOS_DEPLOYMENT_TARGET: "16.0"
+    SWIFT_VERSION: "5.10"
+    CODE_SIGNING_ALLOWED: NO
+    CLANG_ENABLE_MODULES: YES
+    ENABLE_USER_SCRIPT_SANDBOXING: NO
+targets:
+  MadeiraNative:
+    type: framework.static
+    platform: iOS
+    deploymentTarget: "16.0"
+    sources:
+      - path: MadeiraSupport/MadeiraNative.h
+        headerVisibility: public
+      - path: IOS16Compile/ModuleAnchor.c
+    settings:
+      base:
+        PRODUCT_BUNDLE_IDENTIFIER: software.iridium.compile-only.headers
+        GENERATE_INFOPLIST_FILE: YES
+  IridiumIOS16Compile:
+    type: library.static
+    platform: iOS
+    deploymentTarget: "16.0"
+    sources:
+      - path: Iridium
+        includes: ["**/*.swift"]
+      - path: MadeiraSupport
+        includes: ["*.swift"]
+      - path: ../../../testrepos/Madeira/app/Madeira
+        includes: [StikJITHelper.swift, LogStore.swift, LogTail.swift, LogPattern.swift]
+    settings:
+      base:
+        SWIFT_ACTIVE_COMPILATION_CONDITIONS: ["$(inherited)", MADEIRA_RUNTIME]
+        SWIFT_OBJC_BRIDGING_HEADER: MadeiraSupport/IridiumMadeira-Bridging-Header.h
+    dependencies:
+      - target: MadeiraNative
+        embed: false
+      - package: AltKit
+        product: AltKit
+      - package: IridiumPackage
+        product: IridiumCore
+      - package: IridiumPackage
+        product: IridiumRuntime
+      - package: IridiumPackage
+        product: IridiumProfiles
+schemes:
+  IridiumIOS16Compile:
+    build:
+      targets:
+        IridiumIOS16Compile: all
