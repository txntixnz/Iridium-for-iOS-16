+import SwiftUI
+import IridiumCore
+
+/// iOS 18 keeps the original interactive carousel. iOS 16/17 use native scrolling.
+struct LibraryShelf: View {
+    let games: [GameRecord]
+    @ObservedObject var artwork: LibraryArtwork
+    @ObservedObject var controller: LibraryController
+    let play: (GameRecord) -> Void
+    let disabled: (GameRecord) -> Bool
+    let launchTitle: (GameRecord) -> String
+    var launchDetail: (GameRecord) -> String? = { _ in nil }
+    let details: (GameRecord) -> Void
+    @Binding var search: String
+    @Binding var favorites: Bool
+    @Binding var selectedID: UUID?
+    var importGame: () -> Void = {}
+    var settings: () -> Void = {}
+    var acceptsControllerInput = true
+
+    var body: some View {
+        if #available(iOS 18.0, *) {
+            ModernLibraryShelf(games: games, artwork: artwork, controller: controller, play: play, disabled: disabled, launchTitle: launchTitle, launchDetail: launchDetail, details: details, search: $search, favorites: $favorites, selectedID: $selectedID, importGame: importGame, settings: settings, acceptsControllerInput: acceptsControllerInput)
+        } else {
+            LegacyLibraryShelf(games: games, artwork: artwork, controller: controller, play: play, disabled: disabled, launchTitle: launchTitle, launchDetail: launchDetail, details: details, search: $search, favorites: $favorites, selectedID: $selectedID, importGame: importGame, settings: settings, acceptsControllerInput: acceptsControllerInput)
+        }
+    }
+}
+
+private struct LegacyLibraryShelf: View {
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+    let games: [GameRecord]
+    @ObservedObject var artwork: LibraryArtwork
+    @ObservedObject var controller: LibraryController
+    let play: (GameRecord) -> Void
+    let disabled: (GameRecord) -> Bool
+    let launchTitle: (GameRecord) -> String
+    var launchDetail: (GameRecord) -> String? = { _ in nil }
+    let details: (GameRecord) -> Void
+    @Binding var search: String
+    @Binding var favorites: Bool
+    @Binding var selectedID: UUID?
+    var importGame: () -> Void = {}
+    var settings: () -> Void = {}
+    var acceptsControllerInput = true
+
+    private var filtered: [GameRecord] {
+        games.filter { (!favorites || artwork.appearance($0.id).favorite)
+            && (search.isEmpty || artwork.title($0).localizedCaseInsensitiveContains(search)) }
+    }
+    private var selected: GameRecord? { filtered.first { $0.id == selectedID } ?? filtered.first }
+    var body: some View {
+        ScrollViewReader { proxy in
+            VStack(spacing: 16) {
+                HStack {
+                    Text("Iridium").font(.largeTitle.bold())
+                    Spacer()
+                    Button(action: importGame) { Image(systemName: "plus").frame(width: 44, height: 44) }.accessibilityLabel("Add Game")
+                    Button(action: settings) { Image(systemName: "gearshape").frame(width: 44, height: 44) }.accessibilityLabel("Settings")
+                }
+                TextField("Search games", text: $search)
+                    .textFieldStyle(.roundedBorder).textInputAutocapitalization(.never).autocorrectionDisabled()
+                Picker("Library filter", selection: $favorites) {
+                    Text("All Games").tag(false)
+                    Text("Favorites").tag(true)
+                }.pickerStyle(.segmented)
+                if filtered.isEmpty {
+                    IridiumEmptyState("No Games", systemImage: "gamecontroller",
+                        description: Text("Add a game or change your search and filter."))
+                } else {
+                    ScrollView(.horizontal) {
+                        LazyHStack(spacing: 18) {
+                            ForEach(filtered) { game in
+                                Button { selectedID = game.id } label: {
+                                    VStack {
+                                        ArtworkImage(image: artwork.displayImage(artwork.appearance(game.id).cover), title: "", fit: true)
+                                            .frame(width: 140, height: 190).clipShape(RoundedRectangle(cornerRadius: 12))
+                                        Text(artwork.title(game)).lineLimit(2).frame(width: 140)
+                                    }.padding(6).overlay {
+                                        RoundedRectangle(cornerRadius: 16).stroke(selected?.id == game.id ? Color.white : Color.clear, lineWidth: 2)
+                                    }
+                                }.buttonStyle(.plain).id(game.id)
+                                    .accessibilityLabel(artwork.title(game))
+                                    .accessibilityAddTraits(selected?.id == game.id ? [.isSelected] : [])
+                            }
+                        }.padding(4)
+                    }
+                    if let game = selected {
+                        HStack {
+                            Button(launchTitle(game)) { play(game) }.buttonStyle(.borderedProminent).disabled(disabled(game))
+                            Button("Game Options") { details(game) }.buttonStyle(.bordered)
+                        }
+                        if let detail = launchDetail(game) { Text(detail).font(.footnote).foregroundStyle(.secondary) }
+                    }
+                }
+            }.padding().iridiumPageSurface(artwork: artwork, gameID: selected?.id)
+                .onAppear {
+                    artwork.backdropGameID = selected?.id
+                    controller.libraryNavigationActive = acceptsControllerInput
+                }
+                .onDisappear { controller.libraryNavigationActive = false }
+                .onChange(of: acceptsControllerInput) { controller.libraryNavigationActive = $0 }
+                .onChange(of: selected?.id) { id in
+                    artwork.backdropGameID = id
+                    if let id { withAnimation(reduceMotion ? nil : .easeInOut(duration: 0.16)) { proxy.scrollTo(id, anchor: .center) } }
+                }
+                .onReceive(controller.input) { input in
+                    guard acceptsControllerInput, !controller.nativeMenuActive else { return }
+                    switch input {
+                    case .left, .right:
+                        guard !filtered.isEmpty else { return }
+                        let index = filtered.firstIndex { $0.id == selected?.id } ?? 0
+                        selectedID = filtered[min(filtered.count - 1, max(0, index + (input == .left ? -1 : 1)))].id
+                    case .play, .select:
+                        if let game = selected, !disabled(game) { play(game) }
+                    case .options: if let game = selected { details(game) }
+                    case .previousTab: favorites = false
+                    case .nextTab: favorites = true
+                    default: break
+                    }
+                }
+        }
+    }
+}
